-- ================== RENDER LOOP ==================
local frameCounter = 0
local fpsTimer = tick()
local cachedFPSString = "NeverStress | FPS: 60"

Connections.RenderStepped = RunService.RenderStepped:Connect(function(deltaTime)
    if Unloaded then return end
    local now = tick()
    local mouse = GetCorrectMouseLocation()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camPos = Camera.CFrame.Position

    -- 1. WATERMARK & TOAST
    frameCounter = frameCounter + 1
    if now - fpsTimer >= 1 then
        cachedFPSString = string.format("NeverStress | FPS: %d | FOV: %d", frameCounter, Settings.FOV)
        frameCounter = 0
        fpsTimer = now
    end

    if Settings.WatermarkEnabled then
        if not Watermark.Visible then Watermark.Visible = true end
        Watermark.Text = cachedFPSString
    elseif Watermark.Visible then
        Watermark.Visible = false
    end

    if ToastTimer > now then
        ToastText.Visible = true
    elseif ToastText.Visible then
        ToastText.Visible = false
    end

    -- 2. CROSSHAIR
    if Settings.CustomCrosshair then
        local sz, gap, col = Settings.CrosshairSize, Settings.CrosshairGap, Settings.CrosshairColor
        CrosshairLines.Left.From   = Vector2.new(screenCenter.X - gap - sz, screenCenter.Y)
        CrosshairLines.Left.To     = Vector2.new(screenCenter.X - gap, screenCenter.Y)
        CrosshairLines.Left.Color  = col
        if not CrosshairLines.Left.Visible then CrosshairLines.Left.Visible = true end

        CrosshairLines.Right.From  = Vector2.new(screenCenter.X + gap, screenCenter.Y)
        CrosshairLines.Right.To    = Vector2.new(screenCenter.X + gap + sz, screenCenter.Y)
        CrosshairLines.Right.Color = col
        if not CrosshairLines.Right.Visible then CrosshairLines.Right.Visible = true end

        CrosshairLines.Top.From    = Vector2.new(screenCenter.X, screenCenter.Y - gap - sz)
        CrosshairLines.Top.To      = Vector2.new(screenCenter.X, screenCenter.Y - gap)
        CrosshairLines.Top.Color   = col
        if not CrosshairLines.Top.Visible then CrosshairLines.Top.Visible = true end

        CrosshairLines.Bottom.From = Vector2.new(screenCenter.X, screenCenter.Y + gap)
        CrosshairLines.Bottom.To   = Vector2.new(screenCenter.X, screenCenter.Y + gap + sz)
        CrosshairLines.Bottom.Color= col
        if not CrosshairLines.Bottom.Visible then CrosshairLines.Bottom.Visible = true end
    elseif CrosshairLines.Left.Visible then
        for _, l in pairs(CrosshairLines) do l.Visible = false end
    end

    -- 3. HITMARKER
    if HitmarkerTimer > 0 then
        HitmarkerTimer = HitmarkerTimer - 1
        local hSz, hGap = 6, 4
        HitmarkerLines.TL.From = Vector2.new(screenCenter.X - hGap - hSz, screenCenter.Y - hGap - hSz)
        HitmarkerLines.TL.To   = Vector2.new(screenCenter.X - hGap, screenCenter.Y - hGap)
        if not HitmarkerLines.TL.Visible then HitmarkerLines.TL.Visible = true end

        HitmarkerLines.TR.From = Vector2.new(screenCenter.X + hGap, screenCenter.Y - hGap)
        HitmarkerLines.TR.To   = Vector2.new(screenCenter.X + hGap + hSz, screenCenter.Y - hGap - hSz)
        if not HitmarkerLines.TR.Visible then HitmarkerLines.TR.Visible = true end

        HitmarkerLines.BL.From = Vector2.new(screenCenter.X - hGap - hSz, screenCenter.Y + hGap + hSz)
        HitmarkerLines.BL.To   = Vector2.new(screenCenter.X - hGap, screenCenter.Y + hGap)
        if not HitmarkerLines.BL.Visible then HitmarkerLines.BL.Visible = true end

        HitmarkerLines.BR.From = Vector2.new(screenCenter.X + hGap, screenCenter.Y + hGap)
        HitmarkerLines.BR.To   = Vector2.new(screenCenter.X + hGap + hSz, screenCenter.Y + hGap + hSz)
        if not HitmarkerLines.BR.Visible then HitmarkerLines.BR.Visible = true end
    elseif HitmarkerLines.TL.Visible then
        for _, l in pairs(HitmarkerLines) do l.Visible = false end
    end

    -- 4. FOV CIRCLE
    if Settings.ShowFOV and Settings.AimbotEnabled then
        FOVCircle.Position = Vector2.new(mouse.X, mouse.Y)
        FOVCircle.Radius = Settings.FOV
        if not FOVCircle.Visible then FOVCircle.Visible = true end
    elseif FOVCircle.Visible then
        FOVCircle.Visible = false
    end

    -- 5. TRIGGERBOT
    if Settings.TriggerbotEnabled then
        RunTriggerbot()
    end

    -- 6. AIMBOT COM MIRA DIRETA E SUAVE
    if Settings.AimbotEnabled and Holding then
        local targetData = GetClosestTarget()
        if targetData then
            if Settings.AimbotMode == "Camera" then
                -- Interpolação suave e alinhada sem entortar a câmera
                local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetData.Position)
                local smoothFactor = math.clamp(deltaTime * (25 / math.max(Settings.Smooth, 1)), 0.05, 1)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, smoothFactor)
            elseif Settings.AimbotMode == "Mouse" and mousemoverel then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetData.Position)
                if onScreen then
                    -- Movimento suave relativo escalado para não puxar descontroladamente
                    local sens = math.max(Settings.Smooth * 2, 2)
                    local deltaX = (screenPos.X - screenCenter.X) / sens
                    local deltaY = (screenPos.Y - screenCenter.Y) / sens
                    mousemoverel(deltaX, deltaY)
                end
            end
        end
    end

    -- 7. ESP OVERLAY
    for player, esp in pairs(ESPContainers) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso"))
        local head = character and character:FindFirstChild("Head")

        local isValid = character 
            and humanoid 
            and humanoid.Health > 0 
            and root 
            and head
            and not (Settings.TeamCheckESP and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team)

        local dist3D = root and (camPos - root.Position).Magnitude or 99999

        if not isValid or dist3D > Settings.MaxDistance then
            if esp.Box.Visible then esp.Box.Visible = false end
            if esp.HealthBarBG.Visible then esp.HealthBarBG.Visible = false end
            if esp.HealthBar.Visible then esp.HealthBar.Visible = false end
            if esp.Tracer.Visible then esp.Tracer.Visible = false end
            if esp.Name.Visible then esp.Name.Visible = false end
            if esp.HealthText.Visible then esp.HealthText.Visible = false end
            if esp.Skeleton[1].Visible then
                for _, l in ipairs(esp.Skeleton) do l.Visible = false end
            end
            if esp.Highlight and esp.Highlight.Enabled then esp.Highlight.Enabled = false end
            continue
        end

        if Settings.HitmarkerEnabled and humanoid.Health < esp.LastHealth then
            HitmarkerTimer = 10
        end
        esp.LastHealth = humanoid.Health

        local rootPos, rootOnScreen = Camera:WorldToViewportPoint(root.Position)
        local headPos, _ = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
        local legPos, _  = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

        if now - esp.LastVisibilityCheck > 0.1 then
            esp.IsVisibleCached = FastIsVisible(root, character)
            esp.LastVisibilityCheck = now
        end
        local currentColor = (Settings.UseVisibleColors and esp.IsVisibleCached) and Settings.VisibleColor or Settings.HiddenColor

        -- CHAMS (HIGHLIGHT)
        if Settings.ChamsESP then
            if not esp.Highlight or esp.Highlight.Parent ~= character then
                if esp.Highlight then esp.Highlight:Destroy() end
                local h = Instance.new("Highlight")
                h.Name = "NeverStress_Highlight"
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.OutlineTransparency = 0
                h.FillColor = Settings.ChamsColor
                h.FillTransparency = Settings.ChamsFillTransparency
                h.Parent = character
                esp.Highlight = h
                esp.LastOutlineColor = nil
            end
            if not esp.Highlight.Enabled then esp.Highlight.Enabled = true end
            if esp.LastOutlineColor ~= currentColor then
                esp.Highlight.OutlineColor = currentColor
                esp.LastOutlineColor = currentColor
            end
        elseif esp.Highlight and esp.Highlight.Enabled then
            esp.Highlight.Enabled = false
        end

        -- SKELETON ESP
        if Settings.SkeletonESP and rootOnScreen then
            local isR15 = character:FindFirstChild("UpperTorso") ~= nil
            local activeBones = isR15 and BonesR15 or BonesR6

            for i = 1, #esp.Skeleton do
                local line = esp.Skeleton[i]
                local bonePair = activeBones[i]
                if bonePair then
                    local p1Name, p2Name = bonePair[1], bonePair[2]

                    if not PartX[p1Name] then
                        local p1 = character:FindFirstChild(p1Name)
                        if p1 then
                            local v, on = Camera:WorldToViewportPoint(p1.Position)
                            PartX[p1Name] = v.X; PartY[p1Name] = v.Y; PartOn[p1Name] = on
                        end
                    end
                    if not PartX[p2Name] then
                        local p2 = character:FindFirstChild(p2Name)
                        if p2 then
                            local v, on = Camera:WorldToViewportPoint(p2.Position)
                            PartX[p2Name] = v.X; PartY[p2Name] = v.Y; PartOn[p2Name] = on
                        end
                    end

                    if PartOn[p1Name] and PartOn[p2Name] then
                        line.From = Vector2.new(PartX[p1Name], PartY[p1Name])
                        line.To   = Vector2.new(PartX[p2Name], PartY[p2Name])
                        line.Color = currentColor
                        line.Thickness = Settings.EspThickness
                        if not line.Visible then line.Visible = true end
                    elseif line.Visible then
                        line.Visible = false
                    end
                elseif line.Visible then
                    line.Visible = false
                end
            end
        elseif esp.Skeleton[1].Visible then
            for _, l in ipairs(esp.Skeleton) do l.Visible = false end
        end

        local boxHeight = math.abs(legPos.Y - headPos.Y)
        local boxWidth = boxHeight / 1.6
        local boxX = rootPos.X - (boxWidth / 2)

        -- 2D BOX
        if Settings.BoxESP and rootOnScreen then
            esp.Box.Size = Vector2.new(boxWidth, boxHeight)
            esp.Box.Position = Vector2.new(boxX, headPos.Y)
            esp.Box.Color = currentColor
            if not esp.Box.Visible then esp.Box.Visible = true end
        elseif esp.Box.Visible then
            esp.Box.Visible = false
        end

        -- HEALTH BAR
        local hp = math.floor(humanoid.Health)
        local maxHp = math.floor(humanoid.MaxHealth)
        local hpPercent = math.clamp(hp / maxHp, 0, 1)

        if Settings.HealthBarESP and rootOnScreen then
            local barWidth = 3
            local barX = boxX - barWidth - 3
            local barHeight = boxHeight * hpPercent

            esp.HealthBarBG.Size = Vector2.new(barWidth, boxHeight)
            esp.HealthBarBG.Position = Vector2.new(barX, headPos.Y)
            if not esp.HealthBarBG.Visible then esp.HealthBarBG.Visible = true end

            esp.HealthBar.Size = Vector2.new(barWidth, barHeight)
            esp.HealthBar.Position = Vector2.new(barX, headPos.Y + (boxHeight - barHeight))
            esp.HealthBar.Color = Color3.fromRGB(math.floor(255 * (1 - hpPercent)), math.floor(255 * hpPercent), 0)
            if not esp.HealthBar.Visible then esp.HealthBar.Visible = true end
        else
            if esp.HealthBarBG.Visible then esp.HealthBarBG.Visible = false end
            if esp.HealthBar.Visible then esp.HealthBar.Visible = false end
        end

        -- TRACERS
        if Settings.TracersESP and rootOnScreen then
            esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            esp.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
            esp.Tracer.Color = Settings.TracerColor
            if not esp.Tracer.Visible then esp.Tracer.Visible = true end
        elseif esp.Tracer.Visible then
            esp.Tracer.Visible = false
        end

        -- NAMES
        if Settings.NameESP and rootOnScreen then
            esp.Name.Text = player.DisplayName or player.Name
            esp.Name.Position = Vector2.new(rootPos.X, headPos.Y - 16)
            if not esp.Name.Visible then esp.Name.Visible = true end
        elseif esp.Name.Visible then
            esp.Name.Visible = false
        end

        -- HEALTH TEXT
        if Settings.HealthTextESP and rootOnScreen then
            esp.HealthText.Text = string.format("%d HP", hp)
            esp.HealthText.Position = Vector2.new(rootPos.X, legPos.Y + 2)
            esp.HealthText.Color = Color3.fromRGB(math.floor(255 * (1 - hpPercent)), math.floor(255 * hpPercent), 0)
            if not esp.HealthText.Visible then esp.HealthText.Visible = true end
        elseif esp.HealthText.Visible then
            esp.HealthText.Visible = false
        end
    end
end)

-- ================== SISTEMA DE CONFIG MASTER ==================
local MasterConfigFile = "NeverStress_MasterConfigs.json"
local MasterProfiles = {}
local SelectedProfileKey = "Default"

local function SerializeCurrentSettings()
    local serialized = {}
    for key, value in pairs(Settings) do
        if typeof(value) == "Color3" then
            serialized[key] = {
                __type = "Color3",
                R = value.R,
                G = value.G,
                B = value.B
            }
        else
            serialized[key] = value
        end
    end
    return serialized
end

local function ApplyDeserializedSettings(data)
    for key, value in pairs(data) do
        if type(value) == "table" and value.__type == "Color3" then
            Settings[key] = Color3.new(value.R, value.G, value.B)
        elseif Settings[key] ~= nil then
            Settings[key] = value
        end
    end
    CurrentAimKey = Keys[Settings.AimKey] or Enum.KeyCode.E
end

local function SaveMasterToDisk()
    if writefile then
        local success, encoded = pcall(function()
            return HttpService:JSONEncode(MasterProfiles)
        end)
        if success then
            writefile(MasterConfigFile, encoded)
        end
    end
end

local function LoadMasterFromDisk()
    if isfile and readfile and isfile(MasterConfigFile) then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(MasterConfigFile))
        end)
        if success and type(decoded) == "table" then
            MasterProfiles = decoded
            return
        end
    end
    MasterProfiles = {
        ["Default"] = SerializeCurrentSettings(),
        ["Legit"]   = SerializeCurrentSettings(),
        ["Rage"]    = SerializeCurrentSettings()
    }
    SaveMasterToDisk()
end

LoadMasterFromDisk()

local function GetProfileNamesList()
    local list = {}
    for name, _ in pairs(MasterProfiles) do
        table.insert(list, name)
    end
    table.sort(list)
    if #list == 0 then table.insert(list, "Default") end
    return list
end

