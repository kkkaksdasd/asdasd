-- ================== RAYCAST DE VISIBILIDADE ==================
local function FastIsVisible(part, character)
    if not part or not character or not LocalPlayer.Character then return false end
    StaticFilterBuffer[1] = LocalPlayer.Character
    StaticFilterBuffer[2] = character
    GlobalRaycastParams.FilterDescendantsInstances = StaticFilterBuffer

    local origin = Camera.CFrame.Position
    return Workspace:Raycast(origin, part.Position - origin, GlobalRaycastParams) == nil
end

local function ResolveTargetPart(character)
    if not character then return nil end
    if Settings.AimPart == "Head" then
        return character:FindFirstChild("Head")
    elseif Settings.AimPart == "UpperTorso" then
        return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    end
    return character:FindFirstChild(Settings.AimPart) or character:FindFirstChild("HumanoidRootPart")
end

-- ================== TRIGGERBOT CALIBRADO ==================
local function RunTriggerbot()
    if not Settings.TriggerbotEnabled then return end
    if tick() - LastTriggerShot < (Settings.TriggerbotDelay / 1000) then return end

    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local unitRay = Camera:ViewportPointToRay(viewportCenter.X, viewportCenter.Y)

    StaticFilterBuffer[1] = LocalPlayer.Character
    StaticFilterBuffer[2] = Camera
    GlobalRaycastParams.FilterDescendantsInstances = StaticFilterBuffer

    local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, GlobalRaycastParams)
    if result and result.Instance then
        local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
        local player = Players:GetPlayerFromCharacter(hitModel)

        if player and player ~= LocalPlayer then
            if Settings.TriggerbotTeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                return
            end
            local humanoid = hitModel:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                LastTriggerShot = tick()
                if mouse1click then mouse1click() end
            end
        elseif Settings.TargetBots and hitModel and IsValidBotModel(hitModel) then
            local humanoid = hitModel:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                LastTriggerShot = tick()
                if mouse1click then mouse1click() end
            end
        end
    end
end

-- ================== BUSCA DE ALVO PRECISA (COM LOCK) ==================
local function GetClosestTarget()
    -- Se já temos um alvo travado e ele ainda é válido, continua nele!
    if CurrentLockedTarget and CurrentLockedTarget.Parent then
        local hum = CurrentLockedTarget:FindFirstChildOfClass("Humanoid")
        local part = ResolveTargetPart(CurrentLockedTarget)
        if hum and hum.Health > 0 and part then
            if not Settings.VisibleAim or FastIsVisible(part, CurrentLockedTarget) then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local targetPos = part.Position
                    if Settings.PredictMovement and CurrentLockedTarget:FindFirstChild("HumanoidRootPart") then
                        local vel = CurrentLockedTarget.HumanoidRootPart.AssemblyLinearVelocity
                        targetPos = targetPos + (vel * Settings.PredictionFactor)
                    end
                    return {Character = CurrentLockedTarget, Part = part, Position = targetPos}
                end
            end
        end
    end

    local bestTarget = nil
    local shortestDist = Settings.FOV
    local mousePos = GetCorrectMouseLocation()
    local camPos = Camera.CFrame.Position

    local function EvaluateModel(character, isPlayer, playerObj)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
        if not humanoid or humanoid.Health <= 0 or not root then return end

        if isPlayer and Settings.TeamCheckAim and playerObj and playerObj.Team and LocalPlayer.Team and playerObj.Team == LocalPlayer.Team then
            return
        end

        local dist3D = (camPos - root.Position).Magnitude
        if dist3D > Settings.MaxDistance then return end

        local targetPart = ResolveTargetPart(character)
        if not targetPart then return end

        if Settings.VisibleAim and not FastIsVisible(targetPart, character) then return end

        local finalPos = targetPart.Position
        if Settings.PredictMovement and root.AssemblyLinearVelocity then
            finalPos = finalPos + (root.AssemblyLinearVelocity * Settings.PredictionFactor)
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(finalPos)
        if onScreen then
            local dist2D = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
            if dist2D < shortestDist then
                shortestDist = dist2D
                bestTarget = {Character = character, Part = targetPart, Position = finalPos}
            end
        end
    end

    -- 1. Avalia Jogadores
    for i = 1, #CachedPlayers do
        local p = CachedPlayers[i]
        if p ~= LocalPlayer and p.Character then
            EvaluateModel(p.Character, true, p)
        end
    end

    -- 2. Avalia Bots
    if Settings.TargetBots then
        for i = #CachedBots, 1, -1 do
            local bot = CachedBots[i]
            if bot and bot.Parent then
                EvaluateModel(bot, false, nil)
            else
                table.remove(CachedBots, i)
            end
        end
    end

    if bestTarget then
        CurrentLockedTarget = bestTarget.Character
    end

    return bestTarget
end

