-- ================== ENCERRAMENTO COMPLETO (UNLOAD) ==================
function UnloadScript()
    if Unloaded then return end
    Unloaded = true

    for _, conn in pairs(Connections) do
        if conn and conn.Disconnect then conn:Disconnect() end
    end
    table.clear(Connections)

    pcall(function()
        FOVCircle:Remove()
        Watermark:Remove()
        ToastText:Remove()
        for _, l in pairs(CrosshairLines) do l:Remove() end
        for _, l in pairs(HitmarkerLines) do l:Remove() end
    end)

    for player, _ in pairs(ESPContainers) do
        RemoveESP(player)
    end
    table.clear(ESPContainers)

    pcall(function()
        if Window and Window.Destroy then Window:Destroy() end
    end)

    pcall(function()
        local modal = SafeGuiParent:FindFirstChild("NeverStress_Modal")
        if modal then modal:Destroy() end
        for _, gui in ipairs(CoreGui:GetChildren()) do
            if gui.Name:find("Bracket") or gui.Name:find("NeverStress") then
                gui:Destroy()
            end
        end
    end)

    print("[NeverStress] Encerrado com sucesso.")
end

